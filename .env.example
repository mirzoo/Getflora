# Iteration 1 works without environment variables.
#
# Database will be enabled in iteration 2:
# DATABASE_URL="postgresql://rebloom:rebloom@localhost:5432/rebloom"
#
# S3-compatible storage will be enabled after listing creation is stable:
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=
